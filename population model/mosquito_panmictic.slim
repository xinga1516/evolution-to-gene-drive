		catn("Deleterious mutations per ind: " + deleterious_per_ind);
		
		//unique_muts = unique(all.haplosomes.mutationsOfType(m7));
		fit_list = c(); L_list = c();
		for (ind in all){
			pos_g1 = ind.haploidGenome1.positionsOfMutationsOfType(m7);
			pos_g2 = ind.haploidGenome2.positionsOfMutationsOfType(m7);
			homo_pos = setIntersection(pos_g1,pos_g2);
			fit = 1.0;L=0;
			if (size(homo_pos)!=0){
				for (i in homo_pos){
					mut_g1 = ind.haploidGenome1.mutationsOfType(m7);
					mut_g1 = mut_g1[mut_g1.position == i];
					mut_g2 = ind.haploidGenome2.mutationsOfType(m7);
					mut_g2 = mut_g2[mut_g2.position == i];
					f = min(c(mut_g1.selectionCoeff,mut_g2.selectionCoeff));
					f = max(c(f,-1));
					fit = fit * (1+f);
					L = L - log(1+f);
				}
			}
			fit_list = c(fit_list,fit); L_list = c(L_list,L);
		}
		if (!isNULL(fit_list)){
			reportObservedAndVirtualLoad();
			catn("Average fitness: " + asString(mean(fit_list)));
			catn("Mean expressed recessive load: " + asString(mean(L_list)));
		}
	}
}

