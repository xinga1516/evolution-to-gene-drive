						if (i.sex=="F"){
							somatic_fitness_new = SOMATIC_FITNESS_MULTIPLIER_F + total_effect_size;
							if (somatic_fitness_new > 1.0)
								somatic_fitness_new = 1.0;
							if (somatic_fitness_new < 0.0)
								somatic_fitness_new = 0.0;
							cat(somatic_fitness_new);
							cat(" ");
						}
					}
				}
				cat("\n");
			}else{
				attribute_list = c();
				for (i in all){
					MUTATIONS = sim.mutationTypes[sim.mutationTypes.id>=10];
					number_of_mutations = c();
					for (mu in MUTATIONS)
						number_of_mutations = c(number_of_mutations,sum(i.haplosomes.countOfMutationsOfType(mu)));
					//print(number_of_mutations);
					total_effect_size = sum(MUTATION_EFFECTSIZE*number_of_mutations);
