							if (EMBRYO_RESISTANCE_CUT_RATE_F_new < 0.0)
								EMBRYO_RESISTANCE_CUT_RATE_F_new = 0.0;
							cat(EMBRYO_RESISTANCE_CUT_RATE_F_new);
							cat(" ");
