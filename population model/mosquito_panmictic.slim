//// START THE SIMULATION BY ADDING AN INITIAL WILD POPULATION.
1 early() {
	// Start with a population of wild type flies.
   sim.addSubpop("p1", asInteger(CAPACITY), 2/5);
	sim.addSubpop("p1000", 0); // cold storage for dead males
   all = p1.individuals;
	if(GENETIC_DIVERSITY){
		all.haplosomes.addNewDrawnMutation(m1,DRIVE_POSITION);
		do{
			// Add wt to the cut-chromosome
			MUTATIONS = sim.mutationTypes[sim.mutationTypes.id>=10];
			mutation_weights = sapply(1:CAPACITY, "1.0 / asFloat(applyValue);");
			copy_numbers = sample(1:CAPACITY,NUMBER_OF_MUTATION,weights=mutation_weights);
			total_effectsize = abs(sum(MUTATION_EFFECTSIZE*copy_numbers/CAPACITY));
			if (DRIVE_CONVERSION_MUTATION)
				ratio = total_effectsize / DRIVE_CONVERSION;
			if (EMBRYO_RESISTANCE_MUTATION)
				ratio = total_effectsize / EMBRYO_RESISTANCE_CUT_RATE_F_INPUT;
			if (SOMATIC_FITNESS_MUTATION)
				ratio = total_effectsize / SOMATIC_FITNESS_MULTIPLIER_F;
		}while(ratio>INITIAL_ERROR_RATIO);
		//print("================"+total_effectsize/AVERAGE_FLIGHT_PERFORMANCE*DISTANCE);
		print(copy_numbers);
		for (i in 0:(NUMBER_OF_MUTATION-1)){
			random_inds = sample(all,asInteger(copy_numbers[i]));
			for (ind in random_inds){
				if (runif(1)<0.5)
					ind.haploidGenome1.addNewDrawnMutation(MUTATIONS[i],MUTATION_POSITIONS[i]);
				else
					ind.haploidGenome2.addNewDrawnMutation(MUTATIONS[i],MUTATION_POSITIONS[i]);
			}
		}
	}else{
		if (INBREEDING_MUTATION){
			all.haplosomes.addNewDrawnMutation(m1,DRIVE_POSITION);
		}else{
			for (i in seqLen(NUM_GRNAS))
				all.haplosomes.addNewDrawnMutation(m1,i);
		}
	}

   female_ages = size(INITIAL_FEMALE_AGE_DISTRIBUTION) - 1;
   male_ages = size(INITIAL_MALE_AGE_DISTRIBUTION) - 1;
   for (ind in all) {
   	if (ind.sex == "F") {
      	ind.age = sample(0:female_ages, 1, F, INITIAL_FEMALE_AGE_DISTRIBUTION);
      }
      else {
         ind.age = sample(0:male_ages, 1, F, INITIAL_MALE_AGE_DISTRIBUTION);
      }
   }
   all.tag = 0;
}

//// DROP A GROUP OF MODIFIED INDIVIDUALS INTO THE POPULATION.
21: early() {
	 if (!NO_DROP & community.tick == RELEASE_TICK){
    	// Add a drop of modified individuals to p1.
   	if (MALE_ONLY_DROP)
        // Drop a population of only males.
        sim.addSubpop("p2", asInteger(DROP_SIZE), 1.0);
    	else if (FEMALE_ONLY_DROP)
        // Drop a population of only females.
        sim.addSubpop("p2", asInteger(DROP_SIZE), 0.0);
    	else
        sim.addSubpop("p2", asInteger(DROP_SIZE));

    	drop = p2.individuals;
    	drop.age = 2;
    	drop.tag = 0;
    	drop.color = "purple";

    	if (GENETIC_DIVERSITY | INBREEDING_MUTATION){
			// Now set the drop individuals to the correct genotypes:
			drop.haplosomes.addNewDrawnMutation(m2,DRIVE_POSITION);
			//		drop_males = drop[drop.sex=="M"];
			//		drop_males.haploidGenome2.addNewDrawnMutation(m7,NUMBER_OF_GENEELEMENT);
			// For heterozygous drop, one of the chromosomes is set to wild type:
			if (HETEROZYGOUS_DROP)
				drop.haploidGenome2.addNewDrawnMutation(m1,DRIVE_POSITION);
		}else{
			for (i in seqLen(NUM_GRNAS))
				drop.haplosomes.addNewDrawnMutation(m2,i);
			if (HETEROZYGOUS_DROP)
				for (i in seqLen(NUM_GRNAS))
					drop.haploidGenome2.addNewDrawnMutation(m1, i);
		}

    	// Now that genes have been set, move all the individuals from the drop into p1:
    	p1.takeMigrants(drop);
    	p2.removeSubpopulation();
	}
}

