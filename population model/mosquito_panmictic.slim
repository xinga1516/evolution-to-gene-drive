//// AGE BASED SURVIVAL RULES.
early() {
    all = p1.individuals;
    new_larvae = sum(all.age == 0);
    old_larvae = sum(all.age == 1);
    f_larvae = sum(all[all.sex == "F"].age==0);
    defineGlobal("ACTUAL_LARVAE", f_larvae);

    // competition_ratio = (new_larvae + old_larvae * OLD_LARVA_COMPETITION_FACTOR) / ((2 * NUM_ADULT_FEMALES / AVG_NUM_EGG_BATCHES) * (OLD_LARVA_COMPETITION_FACTOR + BETAMAX));
    // competition_ratio = (new_larvae + old_larvae * OLD_LARVA_COMPETITION_FACTOR) / (NUM_ADULT_FEMALES * (BETAMAX + 2 * 0.285714 * 0.35));
    // competition_ratio = (new_larvae + old_larvae * OLD_LARVA_COMPETITION_FACTOR) / (NUM_ADULT_FEMALES * (BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + 2 * 0.285714 * OLD_LARVA_COMPETITION_FACTOR));
    competition_ratio = (new_larvae + old_larvae * OLD_LARVA_COMPETITION_FACTOR) / EXPECTED_COMPETITION;
    new_larva_fitness = (LOW_DENSITY_GROWTH_RATE / (2*BETAMAX*FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK) / ((LOW_DENSITY_GROWTH_RATE - 1) * competition_ratio + 1)) * 2 * 0.285714;//(1 / (2 * 0.285714))^-competition_ratio;
    for (ind in all) {
        if (ind.age == 0){
            ind.fitnessScaling = new_larva_fitness;
            if (OFFSPRING_EXPANDER<1.0)//(INBREEDING_MUTATION)
					ind.fitnessScaling = ind.fitnessScaling * OFFSPRING_EXPANDER;
		  }
        else if (ind.age == 1)
            ind.fitnessScaling = 1.0;
        else {
            if (ind.sex == "M")
                ind.fitnessScaling = (4 - ind.age) / (5 - ind.age);
            else
                ind.fitnessScaling = (7 - ind.age) / (8 - ind.age);
        }
    }
}

//// FOR SPECIAL RUNS TO CALC GENETIC LOAD.
late() {
    if (GL_RUN) {
        all = sim.subpopulations[0].individuals;
        total_males = 0;
        fertile_males = 0;
        total_females = 0;
        fertile_females = 0;
        for (ind in all) {
            if (ind.sex == "M") {
                if (!isInfertile(ind))
                    fertile_males = fertile_males + 1;
                total_males = total_males + 1;
            }
            else {
                if (!isInfertile(ind))
                    fertile_females = fertile_females + 1;
                total_females = total_females + 1;
            }
        }
        if (total_males == 0 | total_females == 0)
            new_bonus_pop_factor = 1;
        else {
            if (X_SHRED_RATE == 0)
                new_bonus_pop_factor = (fertile_males / total_males) * (fertile_females / total_females);
            else
                // Need a different bonus pop factor for drives that bias the sex ratio.
                new_bonus_pop_factor = (fertile_males / total_males) * (fertile_females / total_females) * (total_females / (total_females + total_males)) / 0.5;
        }
        rm("PREV_BONUS_POP_FACTOR", removeConstants=T);
        defineConstant("PREV_BONUS_POP_FACTOR", BONUS_POP_FACTOR);
        rm("BONUS_POP_FACTOR", removeConstants=T);
        defineConstant("BONUS_POP_FACTOR", new_bonus_pop_factor);
    }
}

