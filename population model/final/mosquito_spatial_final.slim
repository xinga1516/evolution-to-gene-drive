//// AGE BASED SURVIVAL RULES / VIABILITY COMPETITION.
ticks all early() {
	i2.evaluate(c(p1,p2));
	all = p1.individuals;
	new_larvae = sum(all.age == 0);
	old_larvae = sum(all.age == 1);
	f_larvae = sum(all[all.sex == "F"].age==0);
	defineGlobal("ACTUAL_LARVAE", f_larvae);
	
	// use resource nodes to measure landscape density.
	for (node in p2.individuals){
		// first count the number of individuals feeding from this node.
		customers = i2.nearestNeighbors(node,p1.individualCount,p1);
		new_larvae = sum(customers.age == 0);
		old_larvae = sum(customers.age == 1);
		total_number = new_larvae + old_larvae * OLD_LARVA_COMPETITION_FACTOR;
		for (ind in customers){
			// increment counter for the number of competitors.
			ind.setValue("competitive_pressure",ind.getValue("competitive_pressure")+total_number);
			// increment counter for the number of nodes that this individual forages from.
			ind.setValue("foraged_nodes",ind.getValue("foraged_nodes")+1);
		
		}
	}
	for (ind in all) {
		if (ind.age == 0) {
			competition_ratio = ind.getValue("competitive_pressure")/ind.getValue("foraged_nodes")/EXPECTED_COMPETITION;
			ind.fitnessScaling = (LOW_DENSITY_GROWTH_RATE / (2*BETAMAX*FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK) / ((LOW_DENSITY_GROWTH_RATE - 1) * competition_ratio + 1)) * 2 * 0.285714;//(1 / (2 * 0.285714))^-competition_ratio;
			if (INBREEDING_MUTATION)
				ind.fitnessScaling = ind.fitnessScaling * OFFSPRING_EXPANDER;
		}
		else if (ind.age == 1)
			ind.fitnessScaling = 1.0;
		else {
			// Movement.
			// reset the fitness in the case of migration rate mutation		
			if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION) {
				distance_kernel_parameter = ind_dispersal_distance(ind);
				
				if (REPRISING_BOUNDARIES) {
					do {
						u1 = runif(1);
						u2 = runif(1);
						// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
						dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
						// random angle
						theta = runif(1, 0, 2 * PI);
						// using the ratio of flight performance and average distance
						new_x = ind.x + dispersal_distance * cos(theta) / SPOT;
						new_y = ind.y + dispersal_distance * sin(theta) / SPOT;
						
						// reset the fitness according to individual's dispersal ability
						ind.fitnessScaling = dispersal_fitness(distance_kernel_parameter);
					}
					while (!ind.subpopulation.pointInBounds(c(new_x, new_y)));
					ind.setSpatialPosition(c(new_x, new_y));
				}
				else {
					u1 = runif(1);
					u2 = runif(1);
					// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
					dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
					// random angle
					theta = runif(1, 0, 2 * PI);
					// Toroidal movement.
					new_x = ind.x + dispersal_distance * cos(theta) / SPOT;
					new_y = ind.y + dispersal_distance * sin(theta) / SPOT;
					ind.setSpatialPosition(p1.pointPeriodic(c(new_x, new_y)));

					// reset the fitness according to individual's dispersal ability
					ind.fitnessScaling = dispersal_fitness(distance_kernel_parameter);
				}
			}
			else {
				// without migration rate mutation
				if (REPRISING_BOUNDARIES) {
					do {
						u1 = runif(1);
						u2 = runif(1);
						// there is no difference in flight performance
						// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
						distance_kernel_parameter = DISTANCE;
						// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
						dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
						theta = runif(1, 0, 2 * PI);
						new_x = ind.x + dispersal_distance * cos(theta) / SPOT;
						new_y = ind.y + dispersal_distance * sin(theta) / SPOT;
					}
					while (!ind.subpopulation.pointInBounds(c(new_x, new_y)));
					ind.setSpatialPosition(c(new_x, new_y));
				}
				else {
					u1 = runif(1);
					u2 = runif(1);
					// there is no difference in flight performance
					// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
					distance_kernel_parameter = DISTANCE;
					// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
					dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
					theta = runif(1, 0, 2 * PI);
					// Toroidal movement.
					new_x = ind.x + dispersal_distance * cos(theta) / SPOT;
					new_y = ind.y + dispersal_distance * sin(theta) / SPOT;
					ind.setSpatialPosition(p1.pointPeriodic(c(new_x, new_y)));
				}
			}
			
			if (ind.sex == "M")
				ind.fitnessScaling = (4 - ind.age) / (5 - ind.age);
			else
				ind.fitnessScaling = (7 - ind.age) / (8 - ind.age);
			// print("move");
		}
	}
//	if (INBREEDING_MUTATION)
//		cat("INDIVIDUAL FITNESS CAUSED BY MUTATIONS: ");
}

// Structured first-stage outputs are emitted before legacy console output.
