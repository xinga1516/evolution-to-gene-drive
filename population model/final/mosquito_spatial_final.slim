species all initialize() {
	// Spatial:
	defineCfgParam("OUTPUT_SPATIAL_DATA", F);
	defineCfgParam("OUTPUT_FILE","genetic_diversity_movie");
	defineCfgParam("COMPLEX_OUTPUT", F);
	defineCfgParam("ZPG_STEPHENSI",T);
	defineCfgParam("DISTANCE", 0.03); // average migration distance 0.038
	defineCfgParam("COMPETITION_DIST", 0.01);
	defineConstant("REPRISING_BOUNDARIES", T); // Toroidal if false
	defineConstant("DROP_RADIUS", 0.1);
	defineCfgParam("RELEASE_TICK",6000);
	defineCfgParam("END_TICK",7500);
	defineConstant("SPOT", 1.2533141373155);// sqrt(PI/2),used for two dimensional distance scale(for each dimension
	defineCfgParam("SIM_BOUND",1.0); // the side length of the simulation area
	defineCfgParam("EFFECTIVE_FEMALE_NUMBER",10000); //10000
	catn("SIM BOUND: "+asString(SIM_BOUND));
	// Resource nodel params.
	defineCfgParam("NODES_PER_AREA", 4);
	defineCfgParam("FORAGING_AREA", PI/4*COMPETITION_DIST^2);
	defineGlobal("chasing_cells",c());
	defineConstant("NUMBER_OF_CELLS", asInteger(round(SIM_BOUND/DISTANCE)^2)); //cells number for chasing start detection
	// for chasing start detection
	defineGlobal("cell_pop_size",-1); //the pop size in all cells of five generations before
	for (i in 2:(NUMBER_OF_CELLS*6)){
		defineGlobal("cell_pop_size",c(cell_pop_size,-1));
	}
	defineGlobal("time_pop_size",c(-1,-1,-1,-1,-1,-1)); // the whole pop size in five generations before
	
	// Modify the number of offspring to calc the genetic load.
	defineCfgParam("GL_RUN", F);
	defineConstant("BONUS_POP_FACTOR", 1.0);
	defineConstant("PREV_BONUS_POP_FACTOR", 1.0);
	defineGlobal("ACTUAL_LARVAE", 0);
	
	// NEW STUFF:
	defineCfgParam("REMATE_CHANCE", 0.05);
	defineCfgParam("OLD_LARVA_COMPETITION_FACTOR", 5.0);
	defineCfgParam("NUM_ADULT_FEMALES", asInteger(EFFECTIVE_FEMALE_NUMBER*SIM_BOUND^2));
	defineCfgParam("BETAMAX", 25);
	defineCfgParam("FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK", 0.5);
	
	// larva, old larva, 6 weeks adults, betamax=50/2, no need to divide 2 again
	defineConstant("INITIAL_FEMALE_AGE_DISTRIBUTION", c(FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK*BETAMAX, 0.285714286, 0.285714286, 0.238095238, 0.19047619, 0.142857143, 0.095238095, 0.047619048));
	defineConstant("INITIAL_MALE_AGE_DISTRIBUTION", c(FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK*BETAMAX, 0.285714286, 0.285714286, 0.19047619, 0.095238095));
	catn("GENERATION TIME: 3.167");
	
	// Fitness parameters:
	defineCfgParam("DD_FITNESS_VALUE", 1.0);
	defineCfgParam("DX_FITNESS_VALUE", sqrt(DD_FITNESS_VALUE));
	defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_F", 0.9);
	defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_M", 1.0);
	
	// Drive type:
	defineCfgParam("HOMING_DRIVE", T);
	defineCfgParam("RECESSIVE_FEMALE_STERILE_SUPPRESSION_DRIVE", T);
	
	// HDR phase parameters:
	defineCfgParam("DRIVE_CONVERSION", 0.85);
	defineCfgParam("HOMING_PHASE_CUT_RATE_F", DRIVE_CONVERSION);
	defineCfgParam("HOMING_PHASE_CUT_RATE_M", DRIVE_CONVERSION);
	defineCfgParam("HOMING_EDGE_EFFECT", 0.055);
	defineCfgParam("BASELINE_HOMING_SUCCESS_RATE", 1.0);
	defineCfgParam("PARTIAL_HDR_RATE", 0.0);
	defineCfgParam("PER_OFFSET_PARTIAL_HDR_RATE_INCREASE", 0.0);
	defineCfgParam("PARTIAL_HDR_R1_RATE", 0.0);
	
	// Resistance phase parameters:
	defineCfgParam("NUM_CUT_PHASES", 1);
	defineCfgParam("GERMLINE_RESISTANCE_CUT_RATE_F", 0.0);
	defineCfgParam("GERMLINE_RESISTANCE_CUT_RATE_M", 0.0);
	defineCfgParam("WHOLE_GERMLINE_RESISTANCE_CUT_RATE_F",0.5*(1-DRIVE_CONVERSION));
	defineCfgParam("WHOLE_GERMLINE_RESISTANCE_CUT_RATE_M",0.5*(1-DRIVE_CONVERSION));
	defineCfgParam("LATE_GERMLINE_RESISTANCE_CUT_RATE_F", WHOLE_GERMLINE_RESISTANCE_CUT_RATE_F/(1-HOMING_PHASE_CUT_RATE_F));
	defineCfgParam("LATE_GERMLINE_RESISTANCE_CUT_RATE_M", WHOLE_GERMLINE_RESISTANCE_CUT_RATE_M/(1-HOMING_PHASE_CUT_RATE_M));
	defineCfgParam("EMBRYO_RESISTANCE_CUT_RATE_F_INPUT", 0.08);
	defineCfgParam("EMBRYO_RESISTANCE_CUT_RATE_M", 0.0); 
	defineCfgParam("HET_MOTHER_CAS_INHERITANCE", 1.83);
	defineCfgParam("R1_OCCURRENCE_RATE", 0.0);
	
	// General drive parameters:
	defineCfgParam("NUM_GRNAS", 1);
	defineCfgParam("GRNA_ACTIVITY_VARIATION", 0.0);
	defineCfgParam("GLOBAL_SATURATION_FACTOR", 1.5); // Has no effect when set to 2 and when grna_factor=1
	defineCfgParam("MALE_ONLY_PROMOTER", F);
	defineCfgParam("GRNA_SATURATION_SIMULATED", F);
	
	// Ecology and drop parameters:
	defineCfgParam("CAPACITY", asInteger(NUM_ADULT_FEMALES * 11/7 * SIM_BOUND^2));
	defineCfgParam("DROP_SIZE", asInteger(CAPACITY/10));
	defineCfgParam("MAX_ATTEMPTS_TO_FIND_SUITABLE_MATE", 10);
	defineCfgParam("LOW_DENSITY_GROWTH_RATE", 6.0);
	defineCfgParam("MALE_ONLY_DROP", T);
	defineCfgParam("FEMALE_ONLY_DROP", F);
	defineCfgParam("HETEROZYGOUS_DROP", T);
	
	defineCfgParam("NO_DROP", F);
	defineConstant("TRACK_BY_CELL", T);
	defineConstant("EQUILIBRIUM_WT_ALLELE_THRESHOLD", 0.8*2*CAPACITY);
	
	defineConstant("EXPECTED_COMPETITION", (NUM_ADULT_FEMALES * (2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + 2 * 0.285714 * OLD_LARVA_COMPETITION_FACTOR))/4* PI * COMPETITION_DIST^2/SIM_BOUND^2); // individual number aging 0, competition factor of individuals aging 1,
	// the former '2' is for betamax, the latter '2' is for capacity.
	
	// genetic diversity
	defineCfgParam("GENETIC_DIVERSITY",T); // the switch of effectsize mutations (dc and er)
	defineCfgParam("GENETIC_DIVERSITY_CONTROL",F);
	defineCfgParam("DRIVE_CONVERSION_MUTATION",F);
	defineCfgParam("EMBRYO_RESISTANCE_MUTATION",F);
	defineCfgParam("SOMATIC_FITNESS_MUTATION",F);
	defineCfgParam("INBREEDING_MUTATION",F); //set some recessive lethal mutation
	defineCfgParam("MIGRATION_RATE_MUTATION",T); //varying mosquito dispersal due to genetic diversity
	defineCfgParam("AVERAGE_FLIGHT_PERFORMANCE",0.745092);
	defineCfgParam("DIS_FIT_SLOPE", -0.8);// range from (-infinite,0)
	defineCfgParam("INITIAL_ERROR_RATIO", 0.02);//percentage of the highest acceptable error of average attribute
	// for inbreeding
	defineCfgParam("DELETERIOUS_MEAN_EFFECTSIZE",-0.2);
	defineCfgParam("EFFECTSIZE_GAMMA_ALPHA",2);// average effect size = alpha / beta
	defineCfgParam("OFFSPRING_EXPANDER",1.0);
	defineCfgParam("VIRTUAL_ASSAY_N", 1000);
	
	defineCfgParam("NUMBER_OF_MUTATION",100);
	defineCfgParam("NUMBER_OF_GENEELEMENT",10000);// total of two autosomes, 5000 if inbreeding, 2000 else
	defineCfgParam("CONCAVE_DEGREE",100);// for the change of standard deviation of drive conversion
	defineCfgParam("MUTATION_DISTRIBUTION_B",0.05);// parameter b of the laplace distribution
	defineCfgParam("DRIVE_POSITION",asInteger(NUMBER_OF_GENEELEMENT*6907/(6907+5071)/2));
	
	// First-stage dispersal diagnostics.  All time values are weekly SLiM ticks.
	defineCfgParam("DISPERSAL_OUTPUT", T);
	defineCfgParam("DISPERSAL_PREFIX", "dispersal");
	defineCfgParam("DISPERSAL_OUTPUT_INTERVAL", 1);
	defineCfgParam("DISPERSAL_LOCUS_INTERVAL", 10);
	defineCfgParam("DISPERSAL_EXPORT_INITIAL_INDIVIDUALS", T);
	defineCfgParam("DISPERSAL_INITIAL_ONLY", F);
	defineCfgParam("DISPERSAL_TRAIT_FLOOR", 0.005);
	
	// Calculate activity step between each gRNA.
	if (NUM_GRNAS == 1)
		defineConstant("GRNA_ACTIVITY_STEP", 0);
	else
		defineConstant("GRNA_ACTIVITY_STEP", (2 * GRNA_ACTIVITY_VARIATION)  / (NUM_GRNAS - 1));
	
	// This simulation will use a non-Wright-Fisher model.
	initializeSLiMModelType("nonWF");
	// Mate searching:
	initializeInteractionType(1, "xy", reciprocal=T, maxDistance=DISTANCE);
	// Adult competition: just for foraging count
	initializeInteractionType(2, "xy", reciprocal=T, maxDistance=COMPETITION_DIST/2);
	i2.setInteractionFunction("l", 1.0); // linear to the distance with the maximum strength as 1.0
	// for nni
	initializeInteractionType(3, "xy", reciprocal=T, maxDistance=SIM_BOUND*sqrt(2));//sqrt(2)*
	
	catn("RELEASE_TICK: " + asString(RELEASE_TICK));
}

species resource_node initialize(){
	initializeSpecies(avatar='V',color="cornflowerblue");
	if (REPRISING_BOUNDARIES)
		initializeSLiMOptions(dimensionality = "xy");
	else
		initializeSLiMOptions(dimensionality="xy", periodicity="xy");
}


species mosquito initialize(){
	initializeSpecies(avatar='O');
	if (REPRISING_BOUNDARIES)
		initializeSLiMOptions(keepPedigrees = T, dimensionality = "xy");
	else
		initializeSLiMOptions(keepPedigrees=T, dimensionality="xy", periodicity="xy");
	// Simulate sexual reproduction: A for autosome.
	initializeSex("A");
	
	// Four variations: Wild type, drive, r1 resistance, r2 resistance.
	// 'cut' is a temporary placeholder, and 'gap' represents a missing segment.
	wt = initializeMutationType("m1", 0.5, "f", 0.0);
	dr = initializeMutationType("m2", 0.5, "f", 0.0);
	r1 = initializeMutationType("m3", 0.5, "f", 0.0);
	r2 = initializeMutationType("m4", 0.5, "f", 0.0);
	cut = initializeMutationType("m5", 0.5, "f", 0.0);
	gap = initializeMutationType("m6", 0.5, "f", 0.0);
	//    Y = initializeMutationType("m7",0.5,"f",0.0); // marker of Y chromosome
	variations = c(wt, dr, r1, r2, cut, gap);
	
	if (GENETIC_DIVERSITY){
		catn("NUMBER_OF_MUTATION: "+NUMBER_OF_MUTATION);
		catn("NUMBER_OF_GENEELEMENT: "+NUMBER_OF_GENEELEMENT);
		if (NUMBER_OF_MUTATION>1){
			do{
				positions = sample(seq(0,NUMBER_OF_GENEELEMENT-1),NUMBER_OF_MUTATION);
			}while(sum(positions==DRIVE_POSITION)>=1);
			// set effect size for all mutation locus
			if (DRIVE_CONVERSION_MUTATION){
				if (MUTATION_DISTRIBUTION_B==-1){
					// effect size is drawn from Laplace distribution,
					// standard deviation linearly decrease with the mean dc, b = (0.1653-20/121*mean)/sqrt(2n)
					//b = (0.1653-20/121*DRIVE_CONVERSION)/sqrt(2*NUMBER_OF_MUTATION);
					// sd decreases with mean in concave function.
					b = (0.091/(1-CONCAVE_DEGREE^(-0.484))-(0.091*CONCAVE_DEGREE^DRIVE_CONVERSION/(CONCAVE_DEGREE-CONCAVE_DEGREE^0.516)))/sqrt(2*NUMBER_OF_MUTATION/(log(CAPACITY)+0.5772157+1/2/CAPACITY));}
				else
					b = MUTATION_DISTRIBUTION_B;
			}else if (EMBRYO_RESISTANCE_MUTATION){
				if (MUTATION_DISTRIBUTION_B==-1)
					b = (-1760/2419*EMBRYO_RESISTANCE_CUT_RATE_F_INPUT^2+1760/2419*EMBRYO_RESISTANCE_CUT_RATE_F_INPUT)/sqrt(2*NUMBER_OF_MUTATION/(log(CAPACITY)+0.5772157+1/2/CAPACITY));
				else
					b = MUTATION_DISTRIBUTION_B;
				// In the case of migration rate mutation
			}else if (MIGRATION_RATE_MUTATION){
				if (MUTATION_DISTRIBUTION_B==-1)
					b = sqrt(0.005277/(2*NUMBER_OF_MUTATION/(log(CAPACITY)+0.5772157+1/2/CAPACITY)));
				//b = sqrt(var_S/(2*n))
				else
					b = MUTATION_DISTRIBUTION_B;
			}else if (SOMATIC_FITNESS_MUTATION){
				if (MUTATION_DISTRIBUTION_B==-1)
					b = 0.5;//todo
				else
					b = MUTATION_DISTRIBUTION_B;
			}
			// first draw from uniform distribution
			tmp = runif(asInteger(NUMBER_OF_MUTATION),-1/2,1/2);
			sgn = ifelse(tmp > 0,1,ifelse(tmp==0,0,-1));
			effect_size = -b*sgn*log(1-2*abs(tmp));//seq(0,0,length=NUMBER_OF_MUTATION);
			
			cat("MUTATION LAPLACE DISTRIBUTION PARAMETER b: ");
			catn(b);
			defineGlobal("MUTATION_POSITIONS",positions);
			defineGlobal("MUTATION_EFFECTSIZE",effect_size);
			mutations=c();
			cat("MUTATION_POSITIONS: ");
			catn(positions);
			cat("MUTATION_EFFECTSIZE: ");
			catn(effect_size);
			for (i in 0:(NUMBER_OF_MUTATION-1)){
				tmp = initializeMutationType(i+10,0.5,"f",0.0);
				variations = c(variations,tmp);
				mutations = c(mutations,tmp);}
		}else{
			// when have only one mutation
			defineGlobal("MUTATION_POSITIONS",1);
			defineGlobal("MUTATION_EFFECTSIZE",0.0);
			cat("MUTATION_POSITIONS: ");
			catn(1);
			cat("MUTATION_EFFECTSIZE: ");
			catn(MUTATION_EFFECTSIZE);
			tmp = initializeMutationType(10,0.5,"f",0.0);
			variations = c(variations,tmp);
		}
		print(variations);
		// Variations are all part of g1 genome element.
		initializeGenomicElementType("g1", variations, repEach(1,6+NUMBER_OF_MUTATION));
		//		initializeGenomicElementType("g2", m7, 1.0); // for Y label
		
		if (NUMBER_OF_MUTATION == 1)	{
			initializeGenomicElement(g1, 0, NUMBER_OF_GENEELEMENT);
			initializeRecombinationRate(0.25); //0 linked; 0.5 unlinked.
		}else{
			if (NUMBER_OF_GENEELEMENT!=1){
				initializeGenomicElement(g1, 0, NUMBER_OF_GENEELEMENT-1);
				//				initializeGenomicElement(g2,NUMBER_OF_GENEELEMENT,NUMBER_OF_GENEELEMENT);
				// three chromosomes have proportional number of gene elements with the genetic distance. 721:937:489
				ch2_end = asInteger(6907*NUMBER_OF_GENEELEMENT/(6907+5071))-1;
				//				rates_F = c((1-(1-2*0.499)^(1/ch2_end))/2,0.5,(1-(1-2*0.499)^(1/(ch3_end-ch2_end)))/2,0.5,(1-(1-2*0.499)^(1/(NUMBER_OF_GENEELEMENT-ch3_end)))/2,0.0);
				//				ends_F = c(ch2_end,ch2_end+1,ch3_end,ch3_end+1,NUMBER_OF_GENEELEMENT-1,NUMBER_OF_GENEELEMENT);
				//				rates_M = c((1-(1-2*0.499)^(1/ch2_end))/2,0.5,(1-(1-2*0.499)^(1/(ch3_end-ch2_end)))/2,0.5,0.0);
				//				ends_M = c(ch2_end,ch2_end+1,ch3_end,ch3_end+1,NUMBER_OF_GENEELEMENT);
				//				print(rates_F);
				//				print(ends_F);
				//				initializeRecombinationRate(rates_F,ends_F,sex="F");
				//				initializeRecombinationRate(rates_M,ends_M,sex="M");}
				rates = c(0.721/(ch2_end+1), 0.5, 0.937/(NUMBER_OF_GENEELEMENT-ch2_end-1));
				ends = c(ch2_end,ch2_end+1,NUMBER_OF_GENEELEMENT-1);
				initializeRecombinationRate(rates,ends);}
			else{
				initializeGenomicElement(g1, 0, NUMBER_OF_GENEELEMENT);
				initializeRecombinationRate(0.25,0.5,0.5);
			}
		}
		initializeMutationRate(0.0);
	}else{
		if (INBREEDING_MUTATION){
			defineCfgParam("MUTATION_RATE",2.0*10^(-6));//2.4*10^(-6)
			// set recessive deleterious mutations	
			do{
				positions = sample(seq(0,NUMBER_OF_GENEELEMENT-1),NUMBER_OF_MUTATION);
			}while(sum(positions==DRIVE_POSITION)>=1);
			defineGlobal("DELETERIOUS_MUTATION_POSITIONS",positions);
			cat("DELETERIOUS_MUTATION_POSITIONS: ");
			catn(DELETERIOUS_MUTATION_POSITIONS);
			deleterious_mutation = initializeMutationType(7,0.0,"g",DELETERIOUS_MEAN_EFFECTSIZE,EFFECTSIZE_GAMMA_ALPHA);
			// complete dominance, gamma distribution, mean effect size, alpha
			initializeMutationType(8,0.5,"f",0.0); 
			// normal genes that arenot recessive deleterious

			// set the genomic structure
			initializeGenomicElementType("g1", variations, repEach(1,6));
			initializeGenomicElementType("g2", m7, c(1)); // recessive deleterious genes 
			initializeGenomicElementType("g3", m8, c(1)); // nonfunctional genes
			if (NUMBER_OF_GENEELEMENT!=1){
				initializeGenomicElement(g1, DRIVE_POSITION, DRIVE_POSITION);
				for (i in DELETERIOUS_MUTATION_POSITIONS){
					initializeGenomicElement(g2,i,i);
				}
				non_unfunctional_positions = sort(c(DRIVE_POSITION,DELETERIOUS_MUTATION_POSITIONS));
				if (non_unfunctional_positions[0]!=0){
					initializeGenomicElement(g3,0,non_unfunctional_positions[0]-1);}
				for (i in 0:(length(non_unfunctional_positions)-2)){ 
					start = non_unfunctional_positions[i];
					end = non_unfunctional_positions[i+1];
					if (start!=end-1)
						initializeGenomicElement(g3,start+1,end-1);
				}				
				last_mut_pos = non_unfunctional_positions[length(non_unfunctional_positions)-1];
				if (last_mut_pos != NUMBER_OF_GENEELEMENT-1)
					initializeGenomicElement(g3,last_mut_pos+1,NUMBER_OF_GENEELEMENT-1);	
				
				// two chromosomes have proportional number of gene elements with the genetic distance. 6907:5071
				ch2_end = asInteger(6907*NUMBER_OF_GENEELEMENT/(6907+5071))-1;
				rates = c(0.721/(ch2_end+1), 0.5, 0.937/(NUMBER_OF_GENEELEMENT-ch2_end-1));
				ends = c(ch2_end,ch2_end+1,NUMBER_OF_GENEELEMENT-1);
				initializeRecombinationRate(rates,ends);
				// lethal mutation locus has a rate to produce new mutations
				rates = c();ends=c();start=0;
				deleterious_pos = sort(DELETERIOUS_MUTATION_POSITIONS);
				//all locus has the same new mutation generation rate, 2.4*10^-6
				for (i in deleterious_pos){
					if (i!=start){
						ends = c(ends,i-1,i);
						rates = c(rates,0.0,MUTATION_RATE);
					}else{
						ends = c(ends,i);
						rates = c(rates,MUTATION_RATE);
					}
					start = i+1;
				}
				if (start != NUMBER_OF_GENEELEMENT){
					rates = c(rates,0);
					ends = c(ends,(NUMBER_OF_GENEELEMENT-1));
					initializeMutationRate(rates,ends);
				}else
					initializeMutationRate(rates,ends);
			}
			else{
				initializeGenomicElement(g1, 0, NUMBER_OF_GENEELEMENT);
				initializeRecombinationRate(0.25,0.5,0.5);
				initializeMutationRate(0.0);
			}
		}else{
			// SLiM 4 resolves static callback mutation types at initialization.
			// Define an unused neutral placeholder for no-load runs; it is not
			// included in any genomic element and therefore cannot be generated.
			initializeMutationType(7,0.0,"f",0.0);
			initializeGenomicElementType("g1",variations, c(1,1,1,1,1,1));
			initializeGenomicElement(g1,0,NUM_GRNAS-1);
			initializeRecombinationRate(0.0);
			initializeMutationRate(0.0);
		}
	}

	if (GENETIC_DIVERSITY)
		variations[variations.id >= 10].convertToSubstitution = F;
	
	// These variations overwrite one another.
	variations.mutationStackPolicy = "l";
	variations.mutationStackGroup = 1;
}

//// HELPER FUNC FOR CONSTANTS THAT MAY ASLO BE CONFIGURED VIA COMMAND LINE.
function (void) defineCfgParam(string$ name, lifs value) {
	if (!exists(name))
		defineConstant(name, value);
}

// Return c(Wload, minus_log_Wload, expressed_position_count).
// Preserve the supplied script's SAME-POSITION / WORST-EFFECT rule,
// including compound heterozygotes and mutation stacks.
function (float) loadStats(o<Mutation> a, o<Mutation> b)
{
    shared = setIntersection(a.position, b.position);
    W = 1.0;
    L = 0.0;
    for (pos in shared)
    {
        s = min(c(a[a.position == pos].selectionCoeff,
                  b[b.position == pos].selectionCoeff));
        v = 1.0 + max(c(s, -1.0));
        W = W * v;
        L = L - log(v);
    }
    return c(W, L, asFloat(size(shared)));
}
// Meiosis of two virtual haplotypes, using the model's recombination map.
// Valid for the supplied single simulated chromosome, shared-sex map,
// and absence of recombination() callbacks / complex gene conversion.
function (o<Mutation>) virtualGamete(o<Mutation> a, o<Mutation> b)
{
    if (runif(1) < 0.5)
    {
        tmp = a;
        a = b;
        b = tmp;
    }
    breaks = mosquito.chromosome.drawBreakpoints();
    edges = sort(unique(c(0, breaks, mosquito.chromosome.lastPosition + 1)));
    gamete = a[integer(0)];
    for (k in seqLen(size(edges) - 1))
    {
        if (k % 2 == 0)
            strand = a;
        else
            strand = b;
        keep = (strand.position >= edges[k]) &
               (strand.position < edges[k + 1]);
        gamete = c(gamete, strand[keep]);
    }
    return gamete;
}
function (o<Mutation>) virtualGameteFromIndividual(o<Individual>$ ind)
{
    return virtualGamete(ind.genome1.mutationsOfType(m7),
                         ind.genome2.mutationsOfType(m7));
}
// Equal weight per family replicate. Four distinct founders per replicate.
// W0 and WFS are both measured in virtual grandchildren, before selection.
function (void) reportVirtualLoad(o<Individual> pool, integer$ n)
{
    females = pool[pool.sex == "F"];
    males = pool[pool.sex == "M"];
    if (n < 2)
        stop("Virtual assay requires at least two family replicates.");
    if ((size(females) < 2) | (size(males) < 2))
    {
        catn("VIRTUAL_LOAD: " + community.tick + " " + size(pool) +
             " 0 NA NA NA NA NA");
        return;
    }
    W0 = float(n);
    WFS = float(n);
    for (r in seqLen(n))
    {
        moms = sample(females, 2, replace=F);
        dads = sample(males, 2, replace=F);
        // S1 and S2: two full siblings from founder family A.
        s1a = virtualGameteFromIndividual(moms[0]);
        s1b = virtualGameteFromIndividual(dads[0]);
        s2a = virtualGameteFromIndividual(moms[0]);
        s2b = virtualGameteFromIndividual(dads[0]);
        // U: offspring from a separate founder family B.
        ua = virtualGameteFromIndividual(moms[1]);
        ub = virtualGameteFromIndividual(dads[1]);
        // Share one focal gamete between the two assay arms.
        // This pairs comparisons without changing either marginal assay.
        focal = virtualGamete(s1a, s1b);
        sibMate = virtualGamete(s2a, s2b);
        randomMate = virtualGamete(ua, ub);
        outStats = loadStats(focal, randomMate);
        inStats = loadStats(focal, sibMate);
        W0[r] = outStats[0];
        WFS[r] = inStats[0];
    }
    mean0 = mean(W0);
    meanFS = mean(WFS);
    B = NAN;
    if (mean0 > 0.0)
    {
        if (meanFS > 0.0)
            B = -log(meanFS / mean0) / 0.25;
        else
            B = INF;
    }
    catn("VIRTUAL_LOAD: " + community.tick + " " + size(pool) + " " + n +
         " " + mean0 + " " + meanFS + " " + B +
         " " + sd(W0)/sqrt(n) + " " + sd(WFS)/sqrt(n));
}
// Run once per week from the existing output block.
function (void) reportObservedAndVirtualLoad(void)
{
    observed = p1.individuals;
    observed = observed[observed.age > 0];
    nobs = size(observed);
    if (nobs == 0)
        catn("OBSERVED_LOAD: " + community.tick + " 0 NA NA NA");
    else
    {
        Ws = float(nobs);
        Ls = float(nobs);
        Hs = float(nobs);
        for (k in seqLen(nobs))
        {
            ind = observed[k];
            stats = loadStats(ind.genome1.mutationsOfType(m7),
                              ind.genome2.mutationsOfType(m7));
            Ws[k] = stats[0];
            Ls[k] = stats[1];
            Hs[k] = stats[2];
        }
        catn("OBSERVED_LOAD: " + community.tick + " " + nobs +
             " " + mean(Ws) + " " + mean(Ls) + " " + mean(Hs));
    }
    pool = p1.individuals;
    pool = pool[pool.age > 1];
    reportVirtualLoad(pool, VIRTUAL_ASSAY_N);
}


//// HELPER FUNCTION FOR FORMING A RESISTANCE ALLELE AT A GIVEN LOCUS.
function (void)addResistanceAllele(o<Genome>$ genome, i$ locus) {
	// Resistance alleles form at a specified rate.
	// m3 is R1 allele, m4 is R2.
	if(runif(1) < R1_OCCURRENCE_RATE)
		genome.addNewDrawnMutation(m3, locus);
	else
		genome.addNewDrawnMutation(m4, locus);
}

//// FUNCTION FOR CAS9 EFFECTS IN THE GERMLINE.
function (void)germline(o<Genome>$ child_chromosome, o<Individual>$ parent, f$ resistance_rate) {
	// Determine presence of drive in this parent.
	parent_drive_count = sum(parent.genomes.countOfMutationsOfType(m2) == NUM_GRNAS);
	// If parent doesn't have drive allele, nothing happens in germline.
	if (!parent_drive_count)
		return;
	
	// Chromosome must have wt to cut, or nothing happens.
	if (child_chromosome.countOfMutationsOfType(m1) == 0)
		return;
	
	// Using the resistance rate passed to the function,
	// determine the per phase cut rate.
	grna_factor = 1;
	if (GRNA_SATURATION_SIMULATED)
		grna_factor = NUM_GRNAS;
	
	// This model allows for varying rates of cutting at each locus.
	// Therefore, the cut rate is a vector of rates.
	cas_factor = GLOBAL_SATURATION_FACTOR * grna_factor / (GLOBAL_SATURATION_FACTOR - 1 + grna_factor);
	local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION);
	local_cut_rate = 1 - (1 - resistance_rate)^(local_cas_factor / (NUM_CUT_PHASES * grna_factor));
	// The above cut rate is the first rate in the vector.
	cut_rates = local_cut_rate;
	// Now fill in the rest of the vector.
	for (i in seqLen(NUM_GRNAS - 1)) {
		local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION - (i + 1) * GRNA_ACTIVITY_STEP);
		local_cut_rate = 1 - (1 - resistance_rate)^(local_cas_factor / (NUM_CUT_PHASES * grna_factor));
		// Concatenate the previous vector with the next cut rate calculated:
		cut_rates = c(cut_rates, local_cut_rate);
	}
	
	// Determine if cas9 cuts the chromosome in the germline.
	casCut(child_chromosome, cut_rates);
}

//// FUNCTION FOR CAS9 EFFECTS IN EMBRYO.
function (void)embryo(o<Genome>$ child_chromosome_1, o<Genome>$ child_chromosome_2, o<Individual>$ mother, f$ resistance_rate) {
	// Determine presence of drive in this mother.
	mother_drive_count = sum(mother.genomes.countOfMutationsOfType(m2) == NUM_GRNAS);
	// If mother doesn't have drive allele, nothing happens in embryo.
	if (!mother_drive_count)
		return;
	
	// Determine the per phase cut rate.
	if (HOMING_DRIVE & sum(mother.genomes.countOfMutationsOfType(m1) == NUM_GRNAS) == 1)
		// Special case for homing drive individual that is dr/wt based on experimental data.
		mother_drive_count = HET_MOTHER_CAS_INHERITANCE;
	grna_factor = 1;
	if (GRNA_SATURATION_SIMULATED)
		grna_factor = NUM_GRNAS;
	
	// This model allows for varying rates of cutting at each locus.
	// Therefore, the cut rate is a vector of rates.
	cas_factor = GLOBAL_SATURATION_FACTOR * grna_factor / (GLOBAL_SATURATION_FACTOR - 1 + grna_factor);
	local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION);
	local_cut_rate = 1 - (1 - resistance_rate)^(mother_drive_count * local_cas_factor / (NUM_CUT_PHASES * grna_factor));
	cut_rates = local_cut_rate;
	// Now fill in the rest of the vector.
	for (i in seqLen(NUM_GRNAS - 1)) {
		local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION - (i + 1) * GRNA_ACTIVITY_STEP);
		local_cut_rate = 1 - (1 - resistance_rate)^(mother_drive_count * local_cas_factor / (NUM_CUT_PHASES * grna_factor));
		// Concatenate the previous vector with the next cut rate calculated:
		cut_rates = c(cut_rates, local_cut_rate);
	}
	
	// Then pass the rates as an argument to the casCut funtion to
	// determine if cas9 cuts in the embryo for each chromosome.
	casCut(child_chromosome_1, cut_rates);
	casCut(child_chromosome_2, cut_rates);
}

//// FUNCTION FOR CAS9 CUTTING A TARGET CHROMOSOME.
function (void)casCut(o<Genome>$ chromosome, f cut_rates) {
	// If chromosome has no wild type targets to cut, cas9 does nothing.
	if (chromosome.countOfMutationsOfType(m1) == 0)
		return;
	
	// Vector of possible loci for cas9 to cut:
	wt_loci = chromosome.positionsOfMutationsOfType(m1);
	
	// In each cut phase...
	for (i in seqLen(NUM_CUT_PHASES)) {
		// At each possible locus...
		for (j in seqAlong(wt_loci)) {
			// Check to see if cas9 cuts...
			if (runif(1) < cut_rates[j]) {
				// Convert the locus temporarily to an m5,
				// representing that this site is being cut.
				chromosome.addNewDrawnMutation(m5, wt_loci[j]);
			}
		}
		// If any cuts were made...
		if (chromosome.countOfMutationsOfType(m5)) {
			cut_loci = chromosome.positionsOfMutationsOfType(m5);
			// If just one cut is made, create an R1 or R2 resistance allele.
			if (chromosome.countOfMutationsOfType(m5) == 1)
				addResistanceAllele(chromosome, cut_loci[0]);
			else {
				// If mutlple cuts are made in the same cut phase, loss of
				// function results. Convert leftmost site to m4 (R2) and
				// everthing else through the rightmost site to m6 (cut).
				number_of_cuts = cut_loci[size(cut_loci) - 1] - cut_loci[0];
				for (index in seqLen(number_of_cuts))
					chromosome.addNewDrawnMutation(m6, cut_loci[0] + index + 1);
				chromosome.addNewDrawnMutation(m4, cut_loci[0]);
			}
			// Because some wt loci may have been cut out of the
			// chromosome, remake the vector of possible cut sites
			// to use during the next iteration of the for loop:
			if (chromosome.countOfMutationsOfType(m1) == 0)
				return;
			wt_loci = chromosome.positionsOfMutationsOfType(m1);
		}
	}
}

//// FUNCTION FOR SIMULATING HOMOLOGY DIRECTED REPAIR.
function (void)hdr(o<Genome>$ chromosome, o<Individual>$ parent, f$ cut_rate) {
	// If chromosome has no wild type targets to cut, cas9 does nothing.
	if (chromosome.countOfMutationsOfType(m1) == 0)
		return;
	
	// Determine presence of drive in this parent.
	parent_c1_drive = parent.genome1.countOfMutationsOfType(m2) == NUM_GRNAS;
	parent_c2_drive = parent.genome2.countOfMutationsOfType(m2) == NUM_GRNAS;
	parent_has_drive = parent_c1_drive | parent_c2_drive;
	// If parent doesn't have drive allele, nothing happens.
	if (!parent_has_drive)
		return;
	
	// Rate of cutting during hdr, modified by gRNA saturation and variable cutting activity, if toggled on.
	// This model allows for varying rates of cutting at each locus.
	grna_factor = 1;
	if (GRNA_SATURATION_SIMULATED)
		grna_factor = NUM_GRNAS;
	cas_factor = GLOBAL_SATURATION_FACTOR * grna_factor / (GLOBAL_SATURATION_FACTOR - 1 + grna_factor);
	local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION);
	local_cut_rate = 1 - (1 - cut_rate)^(local_cas_factor / grna_factor);
	cut_rates = local_cut_rate;
	// Now fill in the rest of the vector.
	for (i in seqLen(NUM_GRNAS - 1)) {
		local_cas_factor = cas_factor * (1 + GRNA_ACTIVITY_VARIATION - (i + 1) * GRNA_ACTIVITY_STEP);
		local_cut_rate = 1 - (1 - cut_rate)^(local_cas_factor / grna_factor);
		// Concatenate the previous vector with the next cut rate calculated:
		cut_rates = c(cut_rates, local_cut_rate);
	}
	
	// Vector of possible loci.
	wt_loci = chromosome.positionsOfMutationsOfType(m1);
	
	// At each possible locus...
	for (i in seqAlong(wt_loci))
		// Check to see if cas9 cuts...
		if (runif(1) < cut_rates[i])
			// Convert the locus temporarily to an m5,
			// representing that this site is being cut.
			chromosome.addNewDrawnMutation(m5, wt_loci[i]);
	
	// If any cuts were made...
	if (chromosome.countOfMutationsOfType(m5)) {
		// Determine how extreme the cuts are relative to the target package (the drive).
		cut_loci = chromosome.positionsOfMutationsOfType(m5);
		leftmost_cut_index = cut_loci[0];
		rightmost_cut_index = cut_loci[size(cut_loci) - 1];
		// Sections that have already been cut out of the chromosome
		// also contribute to the size of the cut section.
		missing_loci = chromosome.positionsOfMutationsOfType(m6);
		// Adjusted indecies are offsets from the full span of the possible cut loci.
		adjusted_left_index = leftmost_cut_index - sum(missing_loci < leftmost_cut_index) - leftmost_cut_index;
		rightmost_cut_index = rightmost_cut_index + sum(missing_loci > rightmost_cut_index) - leftmost_cut_index;
		adjusted_right_index = NUM_GRNAS - 1 - rightmost_cut_index;
		
		// Rate of sucessfull homing varies depending on how well the gap matches the homology arm of the drive .
		successful_homing_rate = BASELINE_HOMING_SUCCESS_RATE * (1 - HOMING_EDGE_EFFECT * adjusted_left_index) * (1 - HOMING_EDGE_EFFECT * adjusted_right_index);
		
		// Check to see if homing succeeds.
		if (runif(1) < successful_homing_rate)
			if (GENETIC_DIVERSITY | INBREEDING_MUTATION)
				chromosome.addNewDrawnMutation(m2,DRIVE_POSITION);
			else{
				for (i in seqLen(NUM_GRNAS))
					chromosome.addNewDrawnMutation(m2, i);
			}
		else {
			// A small percentage of of individuals repair the chromosome with partial HDR,
			// resulting in the entire section of the chromosome becoming a resistance allele.
			final_partial_hdr_rate = 1 - (1 - PARTIAL_HDR_RATE) * (1 - PER_OFFSET_PARTIAL_HDR_RATE_INCREASE * adjusted_left_index) * (1 - PER_OFFSET_PARTIAL_HDR_RATE_INCREASE * adjusted_right_index);
			if (runif(1) < final_partial_hdr_rate) {
				// Rarely, partial HDR results in a total R1 allele, though only in haplolethal or recessive lethal drives:
				total_r1_rate = PARTIAL_HDR_R1_RATE * (1 + adjusted_right_index - adjusted_left_index);
				if (GENETIC_DIVERSITY | INBREEDING_MUTATION){
					if (runif(1) < total_r1_rate & (HAPLOLETHAL_DRIVE | RECESSIVE_LETHAL_DRIVE))
						chromosome.addNewDrawnMutation(m3,DRIVE_POSITION);
					else{
						chromosome.addNewDrawnMutation(m4,DRIVE_POSITION);print('yes');}
				}else{
					if (runif(1) < total_r1_rate & (HAPLOLETHAL_DRIVE | RECESSIVE_LETHAL_DRIVE))
						for (i in seqLen(NUM_GRNAS))
							chromosome.addNewDrawnMutation(m3, i);
					else
						for (i in seqLen(NUM_GRNAS))
							chromosome.addNewDrawnMutation(m4, i);
				}
			}
			// If neither homing nor partial HDR occur, normal repair happens.
			else {
				// If just one cut was made, create an R1 or R2 resistance allele.
				if (chromosome.countOfMutationsOfType(m5) == 1)
					addResistanceAllele(chromosome, cut_loci[0]);
				else {
					// If mutlple cuts were made, leftmost site to m4 (R2),
					// everthing else through the rightmost site to m6 (cut).
					number_of_cuts = cut_loci[size(cut_loci) - 1] - cut_loci[0];
					for (index in seqLen(number_of_cuts))
						chromosome.addNewDrawnMutation(m6, cut_loci[0] + index + 1);
					chromosome.addNewDrawnMutation(m4, cut_loci[0]);
				}
			}
		}
	}
}

//// GENE DRIVE IMPLEMENTATION RULES THAT OCCUR IN EVERY CHILD.
species mosquito 1: modifyChild(p1) {
	if (GENETIC_DIVERSITY) {
		if (!GENETIC_DIVERSITY_CONTROL){
			MUTATIONS = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];
			number_of_mutations = c();
			//parent1 is female, parent2 is male
			for (mu in MUTATIONS)
				number_of_mutations = c(number_of_mutations,parent1.genome1.countOfMutationsOfType(mu)+parent1.genome2.countOfMutationsOfType(mu));
			total_effect_size_1 = sum(MUTATION_EFFECTSIZE*number_of_mutations);
			
			number_of_mutations = c();
			for (mu in MUTATIONS)
				number_of_mutations = c(number_of_mutations,parent2.genome1.countOfMutationsOfType(mu)+parent2.genome2.countOfMutationsOfType(mu));
			total_effect_size_2 = sum(MUTATION_EFFECTSIZE*number_of_mutations);	
		}else{
			// the control contains these mutations, but they don't really influence drive characteristics.
			total_effect_size_1 = 0;
			total_effect_size_2 = 0;
		}
	}
	
	if (!NO_DROP & HOMING_DRIVE) {
		if (GENETIC_DIVERSITY) {
			if (DRIVE_CONVERSION_MUTATION){
				HOMING_PHASE_CUT_RATE_F_new = HOMING_PHASE_CUT_RATE_F + total_effect_size_1;
				//cat(HOMING_PHASE_CUT_RATE_F_new + " ");
				if (HOMING_PHASE_CUT_RATE_F_new > 1.0)
					HOMING_PHASE_CUT_RATE_F_new = 1.0;
				if (EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new < 0.0)
					EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = 0.0;
				LATE_GERMLINE_RESISTANCE_CUT_RATE_F_new = 0.5;
				
				HOMING_PHASE_CUT_RATE_M_new = HOMING_PHASE_CUT_RATE_M + total_effect_size_2;
				if (HOMING_PHASE_CUT_RATE_M_new > 1.0)
					HOMING_PHASE_CUT_RATE_M_new = 1.0;
				if (EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new < 0.0)
					EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = 0.0;
				LATE_GERMLINE_RESISTANCE_CUT_RATE_M_new = 0.5;
			}else{
				HOMING_PHASE_CUT_RATE_F_new = HOMING_PHASE_CUT_RATE_F;
				HOMING_PHASE_CUT_RATE_M_new = HOMING_PHASE_CUT_RATE_M;
				LATE_GERMLINE_RESISTANCE_CUT_RATE_F_new = LATE_GERMLINE_RESISTANCE_CUT_RATE_F;
				LATE_GERMLINE_RESISTANCE_CUT_RATE_M_new = LATE_GERMLINE_RESISTANCE_CUT_RATE_M;
			}
			if (EMBRYO_RESISTANCE_MUTATION){
				EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = EMBRYO_RESISTANCE_CUT_RATE_F_INPUT + total_effect_size_1;
				if (EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new > 1.0)
					EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = 1.0;
				if (EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new < 0.0)
					EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = 0.0;
			}else{
				EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = EMBRYO_RESISTANCE_CUT_RATE_F_INPUT;}
		}//end genetic diversity block
		else{
			HOMING_PHASE_CUT_RATE_F_new = HOMING_PHASE_CUT_RATE_F;
			HOMING_PHASE_CUT_RATE_M_new = HOMING_PHASE_CUT_RATE_M;
			LATE_GERMLINE_RESISTANCE_CUT_RATE_F_new = LATE_GERMLINE_RESISTANCE_CUT_RATE_F;
			LATE_GERMLINE_RESISTANCE_CUT_RATE_M_new = LATE_GERMLINE_RESISTANCE_CUT_RATE_M;
			EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new = EMBRYO_RESISTANCE_CUT_RATE_F_INPUT;
		}
		EMBRYO_RESISTANCE_CUT_RATE_F_new = 1-(1-EMBRYO_RESISTANCE_CUT_RATE_F_INPUT_new)^(1/1.83);
		// Apply effects that happen in the germline.
		// First, resistance alleles form.
		if (!MALE_ONLY_PROMOTER)
			germline(child.genome1, parent1, GERMLINE_RESISTANCE_CUT_RATE_F);
		germline(child.genome2, parent2, GERMLINE_RESISTANCE_CUT_RATE_M);
		// Next, homology directed repair allows for homing to occur.
		if (!MALE_ONLY_PROMOTER)
			hdr(child.genome1, parent1, HOMING_PHASE_CUT_RATE_F_new);
		hdr(child.genome2, parent2, HOMING_PHASE_CUT_RATE_M_new);
		// Then additional resistance alleles form.
		if (!MALE_ONLY_PROMOTER)
			germline(child.genome1, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_F_new);
		germline(child.genome2, parent2, LATE_GERMLINE_RESISTANCE_CUT_RATE_M_new);
		
		// Apply effects that happen in the embryo.
		if (!MALE_ONLY_PROMOTER)
			embryo(child.genome1, child.genome2, parent1, EMBRYO_RESISTANCE_CUT_RATE_F_new);
	} // End homing block
	
	// Offspring are distributed away from their mother.
	// In the case of migration rate mutation		
	if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION) {
		flight_performance = AVERAGE_FLIGHT_PERFORMANCE + total_effect_size_1;
		if (REPRISING_BOUNDARIES) {
			do {
				u1 = runif(1);
				u2 = runif(1);
				// mapping from flight performance to distance kernel parameter
				// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
				distance_kernel_parameter = DISTANCE * flight_performance/AVERAGE_FLIGHT_PERFORMANCE;
				// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
				dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
				// random angle
				theta = runif(1, 0, 2 * PI);
				// using the ratio of flight performance and average distance
				new_x = parent1.x + dispersal_distance * cos(theta) / SPOT;
				new_y = parent1.y + dispersal_distance * sin(theta) / SPOT;
			}
			while (!child.subpopulation.pointInBounds(c(new_x, new_y)));
			child.setSpatialPosition(c(new_x, new_y));
		}
		else {
			u1 = runif(1);
			u2 = runif(1);
			// mapping from flight performance to distance kernel parameter
			// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
			distance_kernel_parameter = DISTANCE * flight_performance/AVERAGE_FLIGHT_PERFORMANCE;
			// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
			dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
			// random angle
			theta = runif(1, 0, 2 * PI);
			// Toroidal movement.
			new_x = parent1.x + dispersal_distance * cos(theta) / SPOT;
			new_y = parent1.y + dispersal_distance * sin(theta) / SPOT;
			child.setSpatialPosition(p1.pointPeriodic(c(new_x, new_y)));
		}
	}
	else {
		// without migration rate mutation
		if (REPRISING_BOUNDARIES) {
			do {
				u1 = runif(1);
				u2 = runif(1);
				// there is no difference in flight performance
				// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
				distance_kernel_parameter = DISTANCE;
				// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
				dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
				theta = runif(1, 0, 2 * PI);
				new_x = parent1.x + dispersal_distance * cos(theta) / SPOT;
				new_y = parent1.y + dispersal_distance * sin(theta) / SPOT;
			}
			while (!child.subpopulation.pointInBounds(c(new_x, new_y)));
			child.setSpatialPosition(c(new_x, new_y));
		}
		else {
			// Toroidal movement.
			u1 = runif(1);
			u2 = runif(1);
			// there is no difference in flight performance
			// distance kernel = 4d/m^2 * exp(-2d/m), where m is distance kernel parameter
			distance_kernel_parameter = DISTANCE;
			// a Gamma random variable with shape k = 2 and scale a can be generated by summing two independent exponential random variables, each with mean a
			dispersal_distance = - (distance_kernel_parameter/2)*log(u1*u2);
			theta = runif(1, 0, 2 * PI);
			new_x = parent1.x + dispersal_distance * cos(theta) / SPOT;
			new_y = parent1.y + dispersal_distance * sin(theta) / SPOT;
			child.setSpatialPosition(p1.pointPeriodic(c(new_x, new_y)));
		}
	}
	if (child.countOfMutationsOfType(m4) >= 1)
		child.color = "cyan"; // r2 carrier
	if (child.countOfMutationsOfType(m2) >= 1)
		child.color = "purple"; // drive carrier
	if (child.countOfMutationsOfType(m1) == 2)
		child.color = "white"; // wt
	child.tag = 0;
	child.setValue("competitive_pressure", 0);
	child.setValue("foraged_nodes", 0);
	return T;
}

//// RULES FOR FITNESS BASED ON GENOTYPE.
function (f$)genotypeFitness(o<Individual>$ ind) {
	// Representation of the value of the two chromosomes.
	fitness_value = 1.0;
	
	// Check both chromosomes for drive and type 2 resistance allele.
	// These are the only variants that affect fitness.
	drive_on_1 = ind.genome1.countOfMutationsOfType(m2) == NUM_GRNAS;
	drive_on_2 = ind.genome2.countOfMutationsOfType(m2) == NUM_GRNAS;
	res2_on_1 = ind.genome1.countOfMutationsOfType(m4) > 0;
	res2_on_2 = ind.genome2.countOfMutationsOfType(m4) > 0;
	wt_1 = ind.genome1.countOfMutationsOfType(m1) > 0;
	wt_2 = ind.genome2.countOfMutationsOfType(m1) > 0;
	
	somatic_fitness_mult = 1;
	if (ind.sex == "F"){
		somatic_fitness_mult = SOMATIC_FITNESS_MULTIPLIER_F;
		if (SOMATIC_FITNESS_MUTATION){
			if (!GENETIC_DIVERSITY_CONTROL){
				MUTATIONS = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];
				number_of_mutations = c();
				for (mu in MUTATIONS)
					number_of_mutations = c(number_of_mutations,ind.genome1.countOfMutationsOfType(mu)+ind.genome2.countOfMutationsOfType(mu));
			total_effect_size = sum(MUTATION_EFFECTSIZE*number_of_mutations);
			somatic_fitness_mult = somatic_fitness_mult + total_effect_size;
			if (somatic_fitness_mult > 1.0)
				somatic_fitness_mult = 1.0;
			if (somatic_fitness_mult < 0.0)
				somatic_fitness_mult = 0.0;
			}
		}
	}
	
	// Check both chromosomes for the drive.
	if (drive_on_1) {
		fitness_value = DX_FITNESS_VALUE;
		if (wt_1 | wt_2)
			fitness_value = fitness_value * somatic_fitness_mult;
	}
	if (drive_on_2) {
		fitness_value = DX_FITNESS_VALUE;
		if (wt_1 | wt_2)
			fitness_value = fitness_value * somatic_fitness_mult;
	}
	if (drive_on_1 & drive_on_2){
		if (ZPG_STEPHENSI){
			if (ind.sex == "F")
				fitness_value = DD_FITNESS_VALUE;
			else
				fitness_value = 0.0;
		}else
			fitness_value = DD_FITNESS_VALUE;
	}
			
	
	// Return fitness for individual with this genotype.
	return fitness_value;
}

//// FUNCTION FOR EVALUATING INFERTILITY CAUSED BY SUPRESSION DRIVES.
function (logical)isInfertile(o<Individual>$ ind) {
	dr_count = sum(ind.genomes.countOfMutationsOfType(m2) == NUM_GRNAS);
	r2_count = sum(ind.genomes.countOfMutationsOfType(m4) > 0);
	if (ind.sex == "F") {
		if (RECESSIVE_FEMALE_STERILE_SUPPRESSION_DRIVE)
			if (dr_count + r2_count == 2)
				return T;
	}
	return F;
}

function (float)ind_dispersal_distance(o<Individual>$ ind) {
	if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION){
		MUTATIONS = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];
		number_of_mutations = c();
		for (mu in MUTATIONS)
			number_of_mutations =  c(number_of_mutations,ind.genome1.countOfMutationsOfType(mu)
			+ind.genome2.countOfMutationsOfType(mu));
		total_effect_size = sum(MUTATION_EFFECTSIZE*number_of_mutations);
		flight_performance = AVERAGE_FLIGHT_PERFORMANCE + total_effect_size;
		mating_range = DISTANCE * flight_performance/AVERAGE_FLIGHT_PERFORMANCE;
		if (mating_range < 0.005)
			mating_range = 0.005;
		return mating_range;
	}else
		return DISTANCE;
}

function (float)dispersal_fitness(float$ dispersal_distance){
	if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION){
		//return 1 - abs(dispersal_distance - DISTANCE) / DISTANCE; 
		if (dispersal_distance <= DISTANCE)
			return 1.0;
		else{
			return DIS_FIT_SLOPE * dispersal_distance + 1-DISTANCE*DIS_FIT_SLOPE;
			return 1.085 - 0.142/(1+exp(-88.4*(dispersal_distance -0.033)));
		}
	}else
		return 1.0;
}

//// multiplied to fitness originally computed
species mosquito mutationEffect(m7,p1){return 1.0;}
species mosquito fitnessEffect(p1){
	if (!INBREEDING_MUTATION)
        return 1.0;

    // Apply the cumulative pre-adult viability effect once.
    if (individual.age != 0)
        return 1.0;

    stats = loadStats(
        individual.genome1.mutationsOfType(m7),
        individual.genome2.mutationsOfType(m7));

    return stats[0];
}

//// REPRODUCTION RULES FOR EACH FEMALE.
species mosquito reproduction(p1, "F") {
	// First, evaluate whether reproduction is suppressed by a population suppression drive,
	// Then, select a mate based on fitness, then generate offspring.
	if (individual.age < 2)
		return;
	
	// Check to see if this female is infertile because of drive mechanics:
	if (isInfertile(individual))
		return;
	
	if (individual.tag == 0 | runif(1) < REMATE_CHANCE) {
		// Individual has not yet mated.
		if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION) {
			mating_range = ind_dispersal_distance(individual);
			all_neighbors = i3.nearestNeighbors(individual, p1.individualCount);
			neighbors_ = all_neighbors[all_neighbors.sex == "M"]; // Male neighbors
			neighbors_ = neighbors_[neighbors_.age > 1];
			dists = i3.distance(individual,neighbors_);
			neighbors = neighbors_[dists > 0.0 & dists <= mating_range];
		}
		else {
			all_neighbors = i1.nearestNeighbors(individual, p1.individualCount);
			neighbors = all_neighbors[all_neighbors.sex == "M"]; // Male neighbors
			neighbors = neighbors[neighbors.age > 1];
		}
		
		if (size(neighbors) > 0) { // If no mates are in mate detection range, cannot mate.
			// Females choose a random provisional mate, but make a final mating decision based on the
			// attractiveness of that mate, as determined by the fitness of the mate. If a mate is
			// rejected, the female tries again, up to a maximum number of tries, after which she gives up.
			attempt_no = 0;
			found_mate = F;
			while (1) {
				mate_no = 0;
				if (size(neighbors) > 1)
					mate_no = rdunif(1, max=size(neighbors) - 1);
				selected_mate = neighbors[mate_no];
				// Determine attractiveness of potential mate.
				mate_attractiveness = genotypeFitness(selected_mate)*dispersal_fitness(ind_dispersal_distance(selected_mate));
				// Determine if this mate is chosen, based on attractiveness.
				if (runif(1) < mate_attractiveness) {
					found_mate = T;
					break;  // Select this mate.
				}
				// After ten candidates fail, female gives up.
				attempt_no = attempt_no + 1;
				if (attempt_no == MAX_ATTEMPTS_TO_FIND_SUITABLE_MATE)
					break;
			}
			if (found_mate)
				// The tag stores the mate's individual ID.
				individual.tag = selected_mate.pedigreeID;
		}
	}
	
	if (individual.tag != 0) {
		// Individual has mated, and may lay eggs.
		
		// Females don't always lay eggs:
		if (runif(1) > FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK)
			return;
		
		selected_mate = mosquito.individualsWithPedigreeIDs(individual.tag);
		
		// Fecundity is based on both the crowding/competition in the system, as well as female fitness.
		// Number of offspring number based on binomial distrobution.
		num_offspring = rpois(1, BETAMAX * 2);
		num_offspring = num_offspring * genotypeFitness(individual) * genotypeFitness(selected_mate) 
	*dispersal_fitness(ind_dispersal_distance(individual))*dispersal_fitness(ind_dispersal_distance(selected_mate));
		if (GL_RUN)
			num_offspring = num_offspring / BONUS_POP_FACTOR;
//		if (INBREEDING_MUTATION)
//			num_offspring = num_offspring * OFFSPRING_EXPANDER;
		
		num_offspring = asInteger(round(num_offspring));
		//print(num_offspring);
		for (i in seqLen(num_offspring)) {
			// Add offspring to the subpopulation.
			//do {
			offspring = p1.addCrossed(individual, selected_mate);
			//}while(offspring==NULL & mosquito.getValue("death_code"));
			// only re-reproduce offspring dead of the wrong sex chromosomes
		}
	
	}
}

//// INITIAL NODE SETUP.
ticks all 1 early() {
	// Tile the model area with resource nodes in a regular hexagonal tiling.
	// First some initial geometry.
	hex_side_length = sqrt(4 * FORAGING_AREA / NODES_PER_AREA / 6 / sqrt(3));
	hex_height = hex_side_length * sqrt(3);
	hexes_wide = 1 + asInteger(sqrt(SIM_BOUND) / (1.5 * hex_side_length));
	even_hexes_wide = asInteger(hexes_wide / 2);
	odd_hexes_wide = asInteger(hexes_wide / 2);
	if (hexes_wide % 2 != 0)
		even_hexes_wide = even_hexes_wide + 1;
	hexes_high = asInteger(2 * sqrt(SIM_BOUND) / hex_height) + 1;
	if (hexes_high % 2 == 0)
		num_resource_nodes = hexes_high / 2 * even_hexes_wide + hexes_high / 2 * odd_hexes_wide;
	else
		num_resource_nodes = (asInteger(hexes_high / 2) + 1) * even_hexes_wide + asInteger(hexes_high / 2) * odd_hexes_wide;
	xmax = (hexes_wide - 1) * 1.5 * hex_side_length;
	ymax = (hexes_high - 1) * hex_height / 2;
	// Next initialize the resource node population and place them at the centerpoints of the hexagonal grid.
	resource_node.addSubpop("p2", asInteger(num_resource_nodes));
	// print(num_resource_nodes);
	p2.setSpatialBounds(c(0, 0, xmax, ymax));
	defineGlobal("EXPECTED_ADULT_COMPETITION", CAPACITY/4 * PI * COMPETITION_DIST^2/xmax/ymax);
	x = -1;
	y = -1;
	for (node in p2.individuals) {
		x = x + 1;
		if (y % 2 == 0)
			x = x % even_hexes_wide;
		if (y % 2 != 0)
			x = x % odd_hexes_wide;
		if (x == 0)
			y = y + 1;
		x_coord = x * 3 * hex_side_length;
		total_x_index = 2 * x;
		if (y % 2 != 0) {
			x_coord = x_coord + 1.5 * hex_side_length;
			total_x_index = total_x_index + 1;
		}
		y_coord = y * hex_height / 2;
		node.setSpatialPosition(c(x_coord, y_coord));
		
		// tag will denote edge resource nodes.
		node.tag = 1;
		
		// Resources on the edge of the modeled area have their area cut in half.
		// Thus, they should also only have half as many resource nodes.
		if (total_x_index == 0 | total_x_index == hexes_wide - 1)
			node.tag = 2;
		if (y == 0 | y == hexes_high - 1)
			node.tag = 2;
	}
	all=p2.individuals;
	all.color = "blue";
	
	// Start with a population of wild type mosquitos.
	mosquito.addSubpop("p1", asInteger(CAPACITY), 2/5);
	p1.setSpatialBounds(c(0.0,0.0,xmax,ymax));
	all = p1.individuals;
	
	if(GENETIC_DIVERSITY){
		all.genomes.addNewDrawnMutation(m1,DRIVE_POSITION);
		do{
			// Add wt to the cut-chromosome
			MUTATIONS = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];
			mutation_weights = sapply(1:CAPACITY, "1.0 / asFloat(applyValue);");
			copy_numbers = sample(1:CAPACITY,NUMBER_OF_MUTATION,weights=mutation_weights);
			total_effectsize = abs(sum(MUTATION_EFFECTSIZE*copy_numbers/CAPACITY));
			if (DRIVE_CONVERSION_MUTATION)
				ratio = total_effectsize / DRIVE_CONVERSION;
			if (EMBRYO_RESISTANCE_MUTATION)
				ratio = total_effectsize / EMBRYO_RESISTANCE_CUT_RATE_F_INPUT;
			if (SOMATIC_FITNESS_MUTATION)
				ratio = total_effectsize / SOMATIC_FITNESS_MULTIPLIER_F;
			if (MIGRATION_RATE_MUTATION)
				ratio = total_effectsize/AVERAGE_FLIGHT_PERFORMANCE; 
		}while(ratio>INITIAL_ERROR_RATIO);
		//print("================"+total_effectsize/AVERAGE_FLIGHT_PERFORMANCE*DISTANCE);
		for (i in 0:(NUMBER_OF_MUTATION-1)){
			random_inds = sample(all,copy_numbers[i]);
			for (ind in random_inds){
				if (runif(1)<0.5)
					ind.genome1.addNewDrawnMutation(MUTATIONS[i],MUTATION_POSITIONS[i]);
				else
					ind.genome2.addNewDrawnMutation(MUTATIONS[i],MUTATION_POSITIONS[i]);
			}
		}
	}else{
		if (INBREEDING_MUTATION){
			all.genomes.addNewDrawnMutation(m1,DRIVE_POSITION);
//			// add some initial recessive deleterious mutations
//			for (pos in DELETERIOUS_MUTATION_POSITIONS){
//				inds = sample(all,rdunif(1,1,150));
//				mut = inds[0].genome1.addNewDrawnMutation(m7,position=pos);
//				for (ind in inds){
//					if (runif(1)<0.5)
//						ind.genome1.addMutations(mut);
//					else
//						ind.genome2.addMutations(mut);
//				}
//			}
		}else{
			for (i in seqLen(NUM_GRNAS))
				all.genomes.addNewDrawnMutation(m1,i);
		}
	}
	
	female_ages = size(INITIAL_FEMALE_AGE_DISTRIBUTION) - 1;
	male_ages = size(INITIAL_MALE_AGE_DISTRIBUTION) - 1;
	for (ind in all) {
		if (ind.sex == "F") {
			ind.age = sample(2:female_ages, 1, F, INITIAL_FEMALE_AGE_DISTRIBUTION[2:female_ages]);
		}
		else {
			ind.age = sample(2:male_ages, 1, F, INITIAL_MALE_AGE_DISTRIBUTION[2:male_ages]);
		}
	}
	all.x = runif(p1.individualCount, 0, xmax);
	all.y = runif(p1.individualCount, 0, ymax);
	all.tag = 0;
	all.color = "white";
	all.setValue("competitive_pressure", 0);
	all.setValue("foraged_nodes", 0);
	
	mosquito.addSubpop("p1000", 0); // cold storage for dead males
	
	community.setValue("npops", 1); // track number of subpopulations
	community.setValue("chasing start",0);
	if (GENETIC_DIVERSITY & MIGRATION_RATE_MUTATION & DISPERSAL_OUTPUT) {
		initializeDispersalOutput();
		reportDispersal("initial", DISPERSAL_EXPORT_INITIAL_INDIVIDUALS);
		if (DISPERSAL_INITIAL_ONLY) {
			community.simulationFinished();
			return;
		}
	}
	//	 mosquito.setValue("death_code",0);
}

//// DROP A GROUP OF MODIFIED INDIVIDUALS INTO THE POPULATION.
ticks all 21: early() {
	if (!NO_DROP & community.tick == RELEASE_TICK){
		// Add a drop of modified individuals to p1.
		if (MALE_ONLY_DROP)
			// Drop a population of only males.
			mosquito.addSubpop("p3", asInteger(DROP_SIZE), 1.0);
		else if (FEMALE_ONLY_DROP)
			// Drop a population of only females.
			mosquito.addSubpop("p3", asInteger(DROP_SIZE), 0.0);
		else
			mosquito.addSubpop("p3", asInteger(DROP_SIZE));
		
		drop = p3.individuals;
		drop.age = 2;
		drop.tag = 0;
		drop.color = "purple";
		drop.setValue("competitive_pressure",0);
		drop.setValue("foraged_nodes", 0);
		for (ind in drop) {
			if (REPRISING_BOUNDARIES) {
				do {
					ind_x = 0.5 + rnorm(1, 0, DROP_RADIUS) / SPOT;
					ind_y = 0.5 + rnorm(1, 0, DROP_RADIUS) / SPOT;
				}
				while (!ind.subpopulation.pointInBounds(c(ind_x, ind_y)));
				ind.setSpatialPosition(c(ind_x, ind_y));
			}
			else {
				// Toroidal placement.
				ind_x = 0.5*SIM_BOUND + rnorm(1, 0, DROP_RADIUS) / SPOT;
				ind_y = 0.5*SIM_BOUND + rnorm(1, 0, DROP_RADIUS) / SPOT;
				ind.setSpatialPosition(p1.pointPeriodic(c(ind_x, ind_y)));
			}
		}
		
		if (GENETIC_DIVERSITY | INBREEDING_MUTATION){
			// Now set the drop individuals to the correct genotypes:
			drop.genomes.addNewDrawnMutation(m2,DRIVE_POSITION);
			//		drop_males = drop[drop.sex=="M"];
			//		drop_males.genome2.addNewDrawnMutation(m7,NUMBER_OF_GENEELEMENT);
			// For heterozygous drop, one of the chromosomes is set to wild type:
			if (HETEROZYGOUS_DROP)
				drop.genome2.addNewDrawnMutation(m1,DRIVE_POSITION);
		}else{
			for (i in seqLen(NUM_GRNAS))
				drop.genomes.addNewDrawnMutation(m2,i);
			if (HETEROZYGOUS_DROP)
				for (i in seqLen(NUM_GRNAS))
					drop.genome2.addNewDrawnMutation(m1, i);
		}
		
		// Now that genes have been set, move all the individuals from the drop into p1:
		p1.takeMigrants(drop);
		p3.removeSubpopulation();
		if (TRACK_BY_CELL)
			community.setValue("start_gc_tracking", F); //don't start until number of wt alleles falls below 80% eq
	}
}

