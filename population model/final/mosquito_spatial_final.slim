// First-stage dispersal diagnostics
// Quantiles use linear interpolation at (n-1)*p (R type 7 / NumPy linear).
function (float$) dispersalQuantile(float x, float$ prob) {
    if (!size(x))
        return NAN;
    y = sort(x);
    h = (size(y) - 1) * prob;
    lo = asInteger(floor(h));
    hi = asInteger(ceil(h));
    return y[lo] + (h-lo) * (y[hi]-y[lo]);
}

function (void) initializeDispersalOutput(void) {
    if (DISPERSAL_OUTPUT_INTERVAL < 1 | DISPERSAL_LOCUS_INTERVAL < 1)
        stop("Dispersal diagnostic intervals must be positive integers.");
    if (DISPERSAL_TRAIT_FLOOR != 0.005)
        stop("DISPERSAL_TRAIT_FLOOR must match the 0.005 floor in ind_dispersal_distance().");

    writeFile(DISPERSAL_PREFIX + "_traits.csv",
        "seed,tick,phase,cohort,n,mean,sd,cv,q05,q25,q50,q75,q95,min,max,raw_mean,raw_sd,n_below_floor,n_raw_nonpositive,n_above_0_5,delta_mean_over_initial_sd,sd_over_initial_sd",
        append=F);
    writeFile(DISPERSAL_PREFIX + "_population.csv",
        "seed,tick,phase,n_live,n_age_gt0,n_age_ge2,n_age0,n_age1,n_males_age_gt0,n_females_age_gt0,n_fertile_females,n_active_stored_males,mean_dispersal_cost_fitness,n_zero_cost_fitness",
        append=F);
    writeFile(DISPERSAL_PREFIX + "_diversity.csv",
        "seed,tick,phase,n_live,n_active_stored_males,loci_present_live,loci_segregating_live,loci_fixed_live,loci_absent_live,loci_present_with_storage,loci_absent_with_storage,retained_fraction_live,segregating_fraction_live,he_mean,ho_mean,he_over_initial,segregating_over_initial,genic_variance_raw_trait,variance_raw_trait,total_modifier_copies_live,modifier_copies_per_ind,mutation_objects_live",
        append=F);
    writeFile(DISPERSAL_PREFIX + "_loci.csv",
        "seed,tick,phase,type_id,position,effect,copies_live,p_live,heterozygotes_live,homozygotes_live,copies_active_stored_males,p_with_storage,status_live",
        append=F);
    writeFile(DISPERSAL_PREFIX + "_initial_individuals.csv",
        "seed,index,sex,age,raw_d,trait_d", append=F);
    meta = c("key,value",
        "schema_version,first_stage_outputs_v1",
        "source_sha256,a712ba0103b52ef91a36ced03d28fcdd811a4e9ed7095abf2fbc661aa2a841a1",
        "seed," + getSeed(),
        "m," + NUMBER_OF_MUTATION,
        "laplace_b," + MUTATION_DISTRIBUTION_B,
        "distance_baseline," + DISTANCE,
        "flight_baseline," + AVERAGE_FLIGHT_PERFORMANCE,
        "trait_floor," + DISPERSAL_TRAIT_FLOOR,
        "capacity," + CAPACITY,
        "sim_bound_input," + SIM_BOUND,
        "spatial_xmax," + p1.spatialBounds[2],
        "spatial_ymax," + p1.spatialBounds[3],
        "spatial_area," + (p1.spatialBounds[2] * p1.spatialBounds[3]),
        "time_unit,week_tick",
        "nominal_generation_time_weeks,3.167",
        "output_interval," + DISPERSAL_OUTPUT_INTERVAL,
        "locus_interval," + DISPERSAL_LOCUS_INTERVAL,
        "no_drop," + NO_DROP,
        "dispersal_cost_slope," + DIS_FIT_SLOPE);
    writeFile(DISPERSAL_PREFIX + "_metadata.csv", meta, append=F);
}

function (void) writeTraitRow(float raw, float d, string$ phase, string$ cohort) {
    n = size(d);
    avg=NAN; stdev=NAN; cv=NAN; mn=NAN; mx=NAN; rawmean=NAN; rawsd=NAN;
    if (n) {
        avg=mean(d); mn=min(d); mx=max(d); rawmean=mean(raw);
    }
    if (n > 1) {
        stdev=sd(d); rawsd=sd(raw); cv=stdev/avg;
    }
    key = "dispersal_initial_" + cohort;
    if (phase == "initial")
        community.setValue(key, c(avg, stdev));
    ref = community.getValue(key);
    delta=NAN; sdratio=NAN;
    if (!isNULL(ref) & n > 1 & ref[1] > 0.0) {
        delta=(avg-ref[0])/ref[1];
        sdratio=stdev/ref[1];
    }
    row = c(getSeed(), community.tick, phase, cohort, n, avg, stdev, cv,
        dispersalQuantile(d,0.05), dispersalQuantile(d,0.25),
        dispersalQuantile(d,0.50), dispersalQuantile(d,0.75),
        dispersalQuantile(d,0.95), mn, mx, rawmean, rawsd,
        sum(raw<DISPERSAL_TRAIT_FLOOR), sum(raw<=0.0), sum(d>0.5),
        delta, sdratio);
    writeFile(DISPERSAL_PREFIX + "_traits.csv", paste(row, sep=","), append=T);
}

function (void) reportDispersal(string$ phase, logical$ exportIndividuals) {
    inds = p1.individuals;
    n = size(inds);
    stored = p1000.individuals;
    refs = inds[inds.sex=="F"].tag;
    refs = refs[refs!=0];
    stored = stored[match(stored.pedigreeID, refs)>=0];
    ns = size(stored);
    types = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];

    g = rep(0.0, n);
    copies = rep(0, NUMBER_OF_MUTATION);
    storage = rep(0, NUMBER_OF_MUTATION);
    het = rep(0, NUMBER_OF_MUTATION);
    hom = rep(0, NUMBER_OF_MUTATION);
    locusRows = string(0);
    outputLoci = (phase=="initial") | (community.tick % DISPERSAL_LOCUS_INTERVAL==0) | (n==0);
    for (j in seqAlong(types)) {
        counts = inds.countOfMutationsOfType(types[j]);
        copies[j] = sum(counts);
        storage[j] = sum(stored.countOfMutationsOfType(types[j]));
        het[j] = sum(counts==1);
        hom[j] = sum(counts==2);
        g = g + MUTATION_EFFECTSIZE[j]*counts;
        plive=NAN; ppool=NAN; status="absent";
        if (n) {
            plive=copies[j]/(2.0*n);
            if (copies[j]==2*n)
                status="fixed";
            else if (copies[j]>0)
                status="segregating";
        }
        if (n+ns)
            ppool=(copies[j]+storage[j])/(2.0*(n+ns));
        if (outputLoci)
            locusRows=c(locusRows,paste(c(getSeed(),community.tick,phase,
                types[j].id,MUTATION_POSITIONS[j],MUTATION_EFFECTSIZE[j],
                copies[j],plive,het[j],hom[j],storage[j],ppool,status),sep=","));
    }
    if (outputLoci)
        writeFile(DISPERSAL_PREFIX+"_loci.csv",locusRows,append=T);

    raw = DISTANCE*(1.0+g/AVERAGE_FLIGHT_PERFORMANCE);
    d = pmax(raw, DISPERSAL_TRAIT_FLOOR);
    writeTraitRow(raw,d,phase,"all_live");
    take = inds.age>0;
    writeTraitRow(raw[take],d[take],phase,"age_gt0");
    take = inds.age>=2;
    writeTraitRow(raw[take],d[take],phase,"age_ge2");

    agegt0 = inds[inds.age>0];
    females = agegt0[agegt0.sex=="F"];
    fertile = females[(females.countOfMutationsOfType(m1)>0) |
        (females.countOfMutationsOfType(m3)>0)];
    meanCost=NAN; zeroCost=0;
    if (n) {
        costs=sapply(d,"dispersal_fitness(applyValue);");
        meanCost=mean(costs);
        zeroCost=sum(costs==0.0);
    }
    populationRow=c(getSeed(),community.tick,phase,n,size(agegt0),sum(inds.age>=2),
        sum(inds.age==0),sum(inds.age==1),sum(agegt0.sex=="M"),sum(agegt0.sex=="F"),
        size(fertile),ns,meanCost,zeroCost);
    writeFile(DISPERSAL_PREFIX+"_population.csv",paste(populationRow,sep=","),append=T);

    he=NAN; ho=NAN; va=NAN; vg=NAN; burden=NAN;
    if (n) {
        p=copies/(2.0*n);
        he=mean(2.0*p*(1.0-p));
        ho=mean(het/n);
        va=sum(2.0*p*(1.0-p)*(MUTATION_EFFECTSIZE*DISTANCE/AVERAGE_FLIGHT_PERFORMANCE)^2);
        burden=sum(copies)/n;
    }
    if (n>1)
        vg=var(raw);
    fixed=0;
    if (n)
        fixed=sum(copies==2*n);
    segregating=sum((copies>0)&(copies<2*n));
    if (phase=="initial") {
        community.setValue("dispersal_initial_he",he);
        community.setValue("dispersal_initial_segregating",segregating);
    }
    heRatio=NAN; segRatio=NAN;
    initialHe=community.getValue("dispersal_initial_he");
    initialSeg=community.getValue("dispersal_initial_segregating");
    if (!isNULL(initialHe) & initialHe>0.0)
        heRatio=he/initialHe;
    if (!isNULL(initialSeg) & initialSeg>0)
        segRatio=segregating/initialSeg;
    mutationObjects=0;
    if (n) {
        modifierMutations=inds.genomes.mutations;
        modifierMutations=modifierMutations[modifierMutations.mutationType.id>=10];
        mutationObjects=size(unique(modifierMutations));
    }
    diversityRow=c(getSeed(),community.tick,phase,n,ns,sum(copies>0),segregating,
        fixed,sum(copies==0),sum(copies+storage>0),sum(copies+storage==0),
        sum(copies>0)/NUMBER_OF_MUTATION,segregating/NUMBER_OF_MUTATION,
        he,ho,heRatio,segRatio,va,vg,sum(copies),burden,mutationObjects);
    writeFile(DISPERSAL_PREFIX+"_diversity.csv",paste(diversityRow,sep=","),append=T);

    if (exportIndividuals) {
        individualRows=string(0);
        for (i in seqAlong(inds))
            individualRows=c(individualRows,paste(c(getSeed(),i,inds[i].sex,
                inds[i].age,raw[i],d[i]),sep=","));
        writeFile(DISPERSAL_PREFIX+"_initial_individuals.csv",individualRows,append=T);
    }
}
