	adult_female = sum(all[all.sex == "F"].age>0);
	adult_male = sum(all[all.sex == "M"].age>0);
	pop_size = adult_female + adult_male;
	cat('\n');
	cat("POPULATION_SIZE: " + pop_size + "\n");
	//catn("WT_ALLELES:: " + pop_size*2 + " " + community.tick + " " + pop_size);
