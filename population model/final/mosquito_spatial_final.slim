							cat(" ");
						}
					}
					if (SOMATIC_FITNESS_MUTATION){
						if (i.sex=="F"){
							somatic_fitness_new = SOMATIC_FITNESS_MULTIPLIER_F + total_effect_size;
							if (somatic_fitness_new > 1.0)
								somatic_fitness_new = 1.0;
							if (somatic_fitness_new < 0.0)
								somatic_fitness_new = 0.0;
							cat(somatic_fitness_new);
							cat(" ");
						}
					}
					if (MIGRATION_RATE_MUTATION){
						distance_kernel_parameter = DISTANCE * (AVERAGE_FLIGHT_PERFORMANCE+total_effect_size)/AVERAGE_FLIGHT_PERFORMANCE;
						cat(distance_kernel_parameter);
						cat(" ");
					}
				}
				cat("\n");
			}else{
				attribute_list = c();
				for (i in all){
					MUTATIONS = mosquito.mutationTypes[mosquito.mutationTypes.id>=10];
					number_of_mutations = c();
					for (mu in MUTATIONS)
						number_of_mutations = c(number_of_mutations,sum(i.genomes.countOfMutationsOfType(mu)));
					//print(number_of_mutations);
					total_effect_size = sum(MUTATION_EFFECTSIZE*number_of_mutations);
					if (DRIVE_CONVERSION_MUTATION){
						HOMING_PHASE_CUT_RATE_F_new = HOMING_PHASE_CUT_RATE_F + total_effect_size;
						if (HOMING_PHASE_CUT_RATE_F_new > 1.0)
							HOMING_PHASE_CUT_RATE_F_new = 1.0;
						attribute_list = c(attribute_list,HOMING_PHASE_CUT_RATE_F_new);
					}
					if (EMBRYO_RESISTANCE_MUTATION){
						if (i.sex=="F"){
							EMBRYO_RESISTANCE_CUT_RATE_F_new = EMBRYO_RESISTANCE_CUT_RATE_F_INPUT + total_effect_size;
							if (EMBRYO_RESISTANCE_CUT_RATE_F_new > 1.0)
