							if (somatic_fitness_new < 0.0)
								somatic_fitness_new = 0.0;
							attribute_list = c(attribute_list,somatic_fitness_new);
						}
					}
				}
				if (DRIVE_CONVERSION_MUTATION)
					catn("average attribute: "+asString(average+DRIVE_CONVERSION));
				if (EMBRYO_RESISTANCE_MUTATION)
					catn("average attribute: "+asString(average+EMBRYO_RESISTANCE_CUT_RATE_F_INPUT));
				if (SOMATIC_FITNESS_MUTATION)
					catn("average attribute: "+asString(average+SOMATIC_FITNESS_MULTIPLIER_F));
				catn("attribute standard deviation: "+asString(sd(attribute_list)));
			}
			
		}

	}
	if (INBREEDING_MUTATION){
		all = p1.individuals;
		all = all[all.age>0];
		pop_size = length(all);
		//catn(unique(all.genomes.positionsOfMutationsOfType(m7)));
		catn("Locus number with mutations: " + length(unique(all.genomes.positionsOfMutationsOfType(m7))));
		deleterious_per_ind = sum(all.genomes.countOfMutationsOfType(m7))/pop_size;
		catn("Deleterious mutations per ind: " + deleterious_per_ind);
		
		fit_list = c(); L_list = c();
		for (ind in all){
			pos_g1 = ind.genome1.positionsOfMutationsOfType(m7);
			pos_g2 = ind.genome2.positionsOfMutationsOfType(m7);
			homo_pos = setIntersection(pos_g1,pos_g2);
			fit = 1.0;L=0;
			if (size(homo_pos)!=0){
				for (i in homo_pos){
					mut_g1 = ind.genome1.mutationsOfType(m7);
					mut_g1 = mut_g1[mut_g1.position == i];
					mut_g2 = ind.genome2.mutationsOfType(m7);
					mut_g2 = mut_g2[mut_g2.position == i];
					f = min(c(mut_g1.selectionCoeff,mut_g2.selectionCoeff));
					f = max(c(f,-1));
					fit = fit * (1+f);
					L = L - log(1+f);
				}
			}
			fit_list = c(fit_list,fit); L_list = c(L_list,L);
		}
		if (!isNULL(fit_list)){
			reportObservedAndVirtualLoad();
			catn("Average fitness: " + asString(mean(fit_list)));
			catn("Mean expressed recessive load: " + asString(mean(L_list)));
		}
//		muts_effectsize = unique_muts.selectionCoeff;
//		cat("EFFECTSIZE OF MUTATIONS: ");
//		catn(muts_effectsize);
		
//		// output frequency of mutations
